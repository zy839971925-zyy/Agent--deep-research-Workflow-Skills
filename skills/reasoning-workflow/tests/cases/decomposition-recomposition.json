{
  "case_id": "decomposition-recomposition",
  "intent": "A complex question is decomposed into apparently reasonable subquestions",
  "expected": {
    "lane": [
      "question"
    ],
    "effort": "standard-or-deep",
    "must": [
      "check overlap and material coverage",
      "keep analytic levels coherent",
      "record dependencies among subquestions",
      "perform recomposition test",
      "revise decomposition if perfect branch answers would not answer parent"
    ],
    "must_not": [
      "treat taxonomy/MECE as automatically correct",
      "close on a list of branch answers without parent synthesis"
    ],
    "closure_blockers": [
      "recomposition does not answer parent question"
    ]
  },
  "observables": {
    "expected_events": [
      {
        "event": "decomposition_created"
      },
      {
        "event": "recomposition_checked"
      }
    ],
    "forbidden_events": [],
    "expected_final_state": {},
    "expected_findings": []
  }
}
