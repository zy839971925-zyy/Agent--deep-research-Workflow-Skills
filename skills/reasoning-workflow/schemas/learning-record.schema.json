{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-record.schema.json",
  "title": "Workflow Learning Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learning_id",
    "tier",
    "source_run_refs",
    "source_eval_refs",
    "task_signature",
    "failure_mode",
    "root_cause_class",
    "lesson_type",
    "heuristic",
    "applicability_conditions",
    "anti_conditions",
    "provenance",
    "status",
    "created_at",
    "rollback_ref"
  ],
  "properties": {
    "learning_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "source_run_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "source_eval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_signature": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "failure_mode": {
      "type": "string",
      "minLength": 1
    },
    "root_cause_class": {
      "enum": [
        "problem_misframing",
        "wrong_depth",
        "wrong_routing",
        "context_overload",
        "missing_context",
        "evidence_failure",
        "provenance_failure",
        "instruction_conflict",
        "model_capability_limit",
        "tool_runtime_failure",
        "validator_gap",
        "execution_plan_error",
        "schedule_delegation_error",
        "checkpoint_recovery_error",
        "success_pattern",
        "inefficiency"
      ]
    },
    "lesson_type": {
      "enum": [
        "strategy",
        "recovery",
        "optimization",
        "routing",
        "verification",
        "context",
        "validator_gap"
      ]
    },
    "heuristic": {
      "type": "string",
      "minLength": 1
    },
    "applicability_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anti_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "feedback_types",
        "intrinsic_reflection_only"
      ],
      "properties": {
        "feedback_types": {
          "type": "array",
          "items": {
            "enum": [
              "external_outcome",
              "deterministic_verifier",
              "independent_review",
              "user_correction",
              "ground_truth",
              "benchmark",
              "intrinsic_reflection"
            ]
          }
        },
        "intrinsic_reflection_only": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "supporting_examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "candidate",
        "validated",
        "promoted",
        "downgraded",
        "deprecated",
        "rejected",
        "stale"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "last_validated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "eval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "held_out_eval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regression_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_comparison_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "dual_review_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_patch_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback_ref": {
      "type": "string",
      "minLength": 1
    },
    "usage": {
      "type": "object",
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "helped": {
          "type": "integer",
          "minimum": 0
        },
        "harmed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
