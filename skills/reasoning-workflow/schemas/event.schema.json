{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/reasoning-workflow/event.schema.json",
  "title": "Reasoning Workflow State Event v2",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "work_id",
    "event_seq",
    "timestamp",
    "event_type",
    "from_state_version",
    "to_state_version"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "event_seq": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "from_state_version": {
      "type": "integer",
      "minimum": 0
    },
    "to_state_version": {
      "type": "integer",
      "minimum": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "old": {},
          "new": {}
        },
        "additionalProperties": false
      }
    },
    "invalidates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
