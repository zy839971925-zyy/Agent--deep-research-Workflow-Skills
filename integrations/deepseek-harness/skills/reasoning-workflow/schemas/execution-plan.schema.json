{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/reasoning-workflow/execution-plan.schema.json",
  "title": "Reasoning Workflow Execution Plan v1.1",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "plan_version",
    "objective",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "based_on_problem_model_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "based_on_state_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "strs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "objective",
        "depends_on",
        "output_contract",
        "completion_contract",
        "verification_contract",
        "parallel_policy",
        "node_contract_hash"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "question",
            "action",
            "mixed",
            null
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/strs"
        },
        "input_refs": {
          "$ref": "#/$defs/strs"
        },
        "required_capabilities": {
          "$ref": "#/$defs/strs"
        },
        "preferred_capabilities": {
          "$ref": "#/$defs/strs"
        },
        "output_contract": {
          "type": "object"
        },
        "completion_contract": {
          "type": "object"
        },
        "verification_contract": {
          "type": "object"
        },
        "materiality": {
          "type": "string",
          "enum": [
            "material",
            "supporting",
            "incidental"
          ],
          "default": "supporting"
        },
        "parallel_policy": {
          "type": "string",
          "enum": [
            "preferred",
            "allowed",
            "forbidden"
          ]
        },
        "context_coupling": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "shared_state_access": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "proposed_write",
            "exclusive_write"
          ],
          "default": "read"
        },
        "read_set": {
          "$ref": "#/$defs/strs"
        },
        "write_set": {
          "$ref": "#/$defs/strs"
        },
        "resource_locks": {
          "$ref": "#/$defs/strs"
        },
        "side_effect_class": {
          "type": "string",
          "enum": [
            "none",
            "reversible",
            "consequential",
            "irreversible"
          ],
          "default": "none"
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "easy",
            "bounded",
            "difficult",
            "irreversible"
          ],
          "default": "easy"
        },
        "degradation_policy": {
          "type": "object",
          "properties": {
            "fallbacks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "required_capability",
                  "fallback_capability",
                  "equivalence"
                ],
                "properties": {
                  "required_capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fallback_capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "equivalence": {
                    "type": "string",
                    "enum": [
                      "equivalent",
                      "weaker",
                      "non_substitutable"
                    ]
                  },
                  "contract_delta": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "retry_policy": {
          "type": "object"
        },
        "checkpoint_policy": {
          "type": "object"
        },
        "interaction_policy": {
          "type": "object"
        },
        "node_contract_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "replay_safety": {
          "type": "string",
          "enum": [
            "safe",
            "idempotent",
            "detectable",
            "unsafe"
          ],
          "default": "safe"
        }
      },
      "additionalProperties": false
    }
  }
}